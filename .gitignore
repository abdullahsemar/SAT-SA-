# ==============================================================================
# SAT-SA .gitignore - Clean Repository Rules
# ==============================================================================

# Python Byte-compiled / optimized / binary files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Python Packaging & Distribution
*.egg-info/
*.egg
build/
dist/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

# Virtual Environments
.venv/
venv/
ENV/
env/
.env.virtualenv

# Environment configuration & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
id_rsa
id_ed25519

# Node / Frontend builds & caches
node_modules/
apps/web/dist/
apps/web/.vite/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing, Linters & Coverage caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Runtime Storage & Local Databases
storage/*.db
storage/*.db-journal
storage/*.db-wal
storage/*.sqlite
storage/*.sqlite3
storage/raw_files/
storage/demo_raw_files/
!storage/.gitkeep

# Large Offline Model Weights (.safetensors, .bin, .pt)
# Pinned weights can be provisioned via: uv run python scripts/provision_model.py
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Generated Offline Release Bundles & Packaging Staging
# Recreated via: uv run python scripts/build_offline_bundle.py
deploy/offline_bundle/staging/
deploy/offline_bundle/*.zip

# IDEs, Editors & OS Temporary Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.log
