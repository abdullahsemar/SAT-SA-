FROM nginx:alpine

# Remove default nginx html
RUN rm -rf /usr/share/nginx/html/*

# Copy prebuilt frontend assets (built offline via npm run build)
COPY apps/web/dist /usr/share/nginx/html

# Copy offline nginx configuration
COPY deploy/containers/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
