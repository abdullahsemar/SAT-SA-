# SAT-SA Environment Variables (Development / Offline)
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///storage/sat_sa.db
STORAGE_DIR=storage/raw_files
SESSION_SECRET=dev-insecure-session-secret-change-in-production-must-be-32-chars
SESSION_MAX_AGE_SECONDS=86400
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_ROW_SIZE_BYTES=65536
